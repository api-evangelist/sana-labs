{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sana Assignments Programs API",
    "version": "0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Programs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all programs.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://<domain>.sana.ai/api/v0/programs"
          },
          "docs": "List all programs."
        },
        {
          "info": {
            "name": "Create a program.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://<domain>.sana.ai/api/v0/programs"
          },
          "docs": "Create a program."
        },
        {
          "info": {
            "name": "Get a program.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://<domain>.sana.ai/api/v0/programs/:programId",
            "params": [
              {
                "name": "programId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a program."
        },
        {
          "info": {
            "name": "Update a program.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://<domain>.sana.ai/api/v0/programs/:programId",
            "params": [
              {
                "name": "programId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a program."
        },
        {
          "info": {
            "name": "Delete a program.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://<domain>.sana.ai/api/v0/programs/:programId",
            "params": [
              {
                "name": "programId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a program."
        },
        {
          "info": {
            "name": "Enroll a user to a program.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://<domain>.sana.ai/api/v0/programs/:programId/members",
            "params": [
              {
                "name": "programId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Enroll a user to a program."
        },
        {
          "info": {
            "name": "Unenroll a user from a program.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://<domain>.sana.ai/api/v0/programs/:programId/members",
            "params": [
              {
                "name": "programId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Unenroll a user from a program."
        }
      ]
    }
  ],
  "bundled": true
}