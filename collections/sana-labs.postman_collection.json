                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "<string>" },
                { "key": "client_secret", "value": "<string>" },
                { "key": "scope", "value": "<string>" }
              ]
            }
          },
          "response": []
        }
      ]
