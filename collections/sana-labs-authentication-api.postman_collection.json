          "name": "Request an access token (OAuth 2.0 client credentials).",
          "request": {
            "name": "Request an access token (OAuth 2.0 client credentials).",
            "description": {
              "content": "Exchange client_id and client_secret for a Bearer access token using grant_type=client_credentials. The response includes accessToken, tokenType (bearer), and expiresIn (e.g. 3600 seconds).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
